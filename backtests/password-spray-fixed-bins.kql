// Reconstruction of the historical 10-minute bucket backtest in the lab notes.
let StartUtc = datetime(2026-11-07T00:00:00Z);
let EndUtc = datetime(2026-11-08T00:30:00Z);
SecurityEvent
| where TimeGenerated >= StartUtc and TimeGenerated < EndUtc and EventID == 4625
| where isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1")
| summarize FailedAttempts=count(), DistinctAccounts=dcount(TargetUserName)
    by IpAddress, WindowStart=bin_at(TimeGenerated, 10m, StartUtc)
| extend Matched = FailedAttempts >= 10 and DistinctAccounts >= 3
| summarize ActiveWindows=count(), MatchingWindows=countif(Matched),
    FirstMatchingWindow=minif(WindowStart, Matched),
    PeakAttempts=max(FailedAttempts), PeakAccounts=max(DistinctAccounts)
    by IpAddress
| order by MatchingWindows desc, IpAddress asc
