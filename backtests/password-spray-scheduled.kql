// Event-time replay. Match rows are per scheduled run and source IP.
let StartUtc = datetime(2026-11-07T00:00:00Z);
let EndUtc = datetime(2026-11-08T00:30:00Z);
let Cadence = 5m;
let Lookback = 10m;
SecurityEvent
| where TimeGenerated >= StartUtc and TimeGenerated < EndUtc and EventID == 4625
| where isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1")
| extend FirstRun = bin_at(TimeGenerated, Cadence, StartUtc) + Cadence
| mv-expand RunUtc = range(FirstRun, TimeGenerated + Lookback, Cadence) to typeof(datetime)
| where RunUtc between ((StartUtc + Lookback) .. EndUtc)
| summarize FailedAttempts=count(), DistinctAccounts=dcount(TargetUserName)
    by RunUtc, IpAddress
| where FailedAttempts >= 10 and DistinctAccounts >= 3
| order by RunUtc asc, IpAddress asc
